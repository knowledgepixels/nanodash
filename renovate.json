{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>ashleycaselli/renovate-config"
  ],
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Updates to the parent dependencies should trigger a new patch release",
      "matchFileNames": [
        "pom.xml"
      ],
      "semanticCommitType": "chore",
      "semanticCommitScope": "core-deps"
    },
    {
      "description": "Updates to the dependencies under the build settings element should not trigger any release",
      "matchFileNames": [
        "pom.xml"
      ],
      "matchDepTypes": [
        "build"
      ],
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Updates to the dependencies with scope 'test' should be tagged as 'test(deps)'",
      "matchFileNames": [
        "pom.xml"
      ],
      "matchDepTypes": [
        "test"
      ],
      "semanticCommitType": "test",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Wicket and Wicketstuff share wicket.version and update together as a core dependency; wicket-tester has its own version and stays test(deps)",
      "matchFileNames": [
        "pom.xml"
      ],
      "matchPackageNames": [
        "org.apache.wicket:**",
        "org.wicketstuff:**",
        "!org.apache.wicket:wicket-tester"
      ],
      "groupName": "wicket",
      "semanticCommitType": "chore",
      "semanticCommitScope": "core-deps"
    },
    {
      "description": "Updates to the dependencies defined in package.json should be tagged as 'build(deps)'",
      "matchFileNames": [
        "package.json"
      ],
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    }
  ]
}
