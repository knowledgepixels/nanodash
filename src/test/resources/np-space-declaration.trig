@prefix this: <https://w3id.org/np/RACCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC> .
@prefix sub: <https://w3id.org/np/RACCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  <https://example.org/spaces/test-workshop> a gen:Space, gen:Event;
    rdfs:label "Test Workshop";
    dct:description "A workshop with a <script> tag in its description.";
    <http://schema.org/startDate> "2026-09-15T09:00:00+02:00"^^xsd:dateTime;
    gen:hasAdmin orcid:0000-0002-1267-0234 .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  this: dct:created "2026-09-14T10:00:00.000Z"^^xsd:dateTime;
    dct:creator orcid:0000-0002-1267-0234;
    npx:introduces <https://example.org/spaces/test-workshop> .
}
