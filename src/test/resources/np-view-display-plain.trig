@prefix this: <https://w3id.org/np/RAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAADISP2> .
@prefix sub: <https://w3id.org/np/RAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAADISP2/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

# A view display that declares no description, so the view's own one stands (issue #735).
sub:assertion {
  sub:display a gen:ViewDisplay, gen:ActivatedViewDisplay;
    gen:isDisplayOfView <https://w3id.org/np/RAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAADESC/view>;
    gen:isDisplayFor <https://w3id.org/spaces/example>;
    dct:title "A title of its own" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  this: dct:created "2026-09-24T09:10:00.000Z"^^xsd:dateTime;
    dct:creator orcid:0000-0002-1267-0234 .
}
