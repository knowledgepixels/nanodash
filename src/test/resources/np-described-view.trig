@prefix this: <https://w3id.org/np/RAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAADESC> .
@prefix sub: <https://w3id.org/np/RAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAADESC/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

# A view carrying a description (issue #735). A header view, i.e. the one display type
# that carries no query, so that loading it does not pull in a query nanopub.
sub:assertion {
  sub:view a gen:ResourceView, gen:HeaderView;
    rdfs:label "described-view";
    dct:title "A described view";
    dct:description "What this view is for." .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  this: dct:created "2026-09-24T09:00:00.000Z"^^xsd:dateTime;
    dct:creator orcid:0000-0002-1267-0234;
    npx:embeds sub:view .
}
