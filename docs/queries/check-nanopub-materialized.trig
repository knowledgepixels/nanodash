@prefix this: <https://w3id.org/np/ARTIFACTCODE-PLACEHOLDER> .
@prefix sub: <https://w3id.org/np/ARTIFACTCODE-PLACEHOLDER> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix grlc: <https://w3id.org/kpxl/grlc/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix orcid: <https://orcid.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

sub:Head {
  this: a np:Nanopublication;
    np:hasAssertion sub:assertion;
    np:hasProvenance sub:provenance;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:check-nanopub-materialized a grlc:grlc-query;
    dct:description "This query checks whether a given nanopublication has been materialized into the current space state of the answering Nanopub Query instance, i.e. whether the authority resolver has already processed it and recorded what it grants. It returns one row if some record in the current space state was derived from the nanopublication (npa:viaNanopub), and an empty result otherwise. This is a later milestone than mere ingest, which check-nanopub-loaded probes: role grants, role revocations and other space-state changes only become visible to the space listing queries once this materialization has happened. It is designed to be as cheap as possible (two bound lookups), so it can be used to poll for the arrival of a just-published nanopublication, for example to delay a cache refresh until the publication has taken effect in the views that read the current space state. An empty result does not distinguish 'not yet materialized' from 'materialized but granting nothing', so callers must bound their polling.";
    dct:license <http://www.apache.org/licenses/LICENSE-2.0>;
    rdfs:label "Check if a nanopublication is materialized into the current space state";
    grlc:endpoint <https://w3id.org/np/l/nanopub-query-1.1/repo/spaces>;
    grlc:sparql """prefix npa: <http://purl.org/nanopub/admin/>

select ?record where {
  graph npa:graph {
    npa:thisRepo npa:hasCurrentSpaceState ?stateGraph .
  }
  graph ?stateGraph {
    ?record npa:viaNanopub ?_np_iri .
  }
} limit 1""" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo orcid:0000-0002-1267-0234 .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .

  this: dct:created "2026-10-09T00:00:00Z"^^xsd:dateTime;
    dct:creator orcid:0000-0002-1267-0234;
    dct:license <https://creativecommons.org/licenses/by/4.0/>;
    npx:embeds sub:check-nanopub-materialized;
    rdfs:label "Check if a nanopublication is materialized into the current space state";
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU>;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RA0J4vUn_dekg-U1kK3AOEt02p9mT2WO03uGxLDec1jLw>;
    nt:wasCreatedFromTemplate <https://w3id.org/np/RAEFAt-QcFK0ZhqfvlsmS10BnzGJA0xwOICZXkO-ai87k> .
}
